{
  "name": "powerline-designer",
  "productName": "PowerLine Designer",
  "description": "Professional Electrical Distribution Line CAD, BOQ schedule, and stateful .pld drawing system.",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "main": "electron/main.cjs",
  "author": {
    "name": "Kaushik Paul",
    "url": "https://github.com/kpaul466"
  },
  "homepage": "https://kpaul466.github.io/Designer/",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "node scripts/generate-version.mjs",
    "build": "vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist release server.js",
    "lint": "tsc --noEmit",
    "wb-places": "node scripts/generate-wb-places.mjs",
    "generate-icon": "node scripts/generate-icon.mjs",
    "electron": "electron .",
    "electron:build": "vite build && electron-builder",
    "electron:pack:win": "electron-builder --win",
    "electron:pack:mac": "electron-builder --mac",
    "electron:pack:linux": "electron-builder --linux",
    "cap:sync": "cap sync",
    "cap:android": "cap open android"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html2canvas-pro": "^2.5.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "ol": "^10.11.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.powerline.designer",
    "productName": "PowerLine Designer",
    "copyright": "Copyright © 2026 Kaushik Paul",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "pld",
        "name": "PowerLine Drawing",
        "description": "PowerLine Designer Project File",
        "role": "Editor",
        "icon": "public/powerline-icon.png",
        "mimeType": "application/x-powerline-designer"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "public/powerline-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PowerLine Designer",
      "fileAssociations": [
        {
          "ext": "pld",
          "name": "PowerLine Drawing",
          "description": "PowerLine Designer Project File"
        }
      ]
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity",
      "icon": "public/powerline-icon.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Engineering",
      "icon": "public/powerline-icon.png",
      "mimeTypes": ["application/x-powerline-designer"]
    }
  }
}
